rules_version = '2';

// =============================================================================
// Garage Terminal: Cloud Storage security rules
//
// Library files live at library/{slug}/{fileName}, where {slug} is the
// library item's ID in Firestore (library/{slug}). Home Projects photos live at
// homeprojects/{uid}/photos/{photoId}, private to that member.
//
//   - Anyone can download a file whose library item is published.
//   - Draft items' files are visible only to the sysop.
//   - Only the sysop can upload (max 50 MB) or delete.
//   - Everything else in the bucket is locked.
//
// These rules read Firestore (firestore.get / firestore.exists) to check the
// item's status and whether the caller is sysop.
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isPublished(slug) {
      return firestore.get(/databases/(default)/documents/library/$(slug)).data.status == 'published';
    }

    match /library/{slug}/{fileName} {
      allow read: if isAdmin() || isPublished(slug);

      allow create, update: if isAdmin()
        && request.resource.size <= 50 * 1024 * 1024;

      allow delete: if isAdmin();
    }

    // Home Projects photos (apps/home-projects): private to the member who
    // added them. Images only, up to 10 MB each (the app shrinks photos first).
    match /homeprojects/{uid}/photos/{photoId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && photoId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ---------- the BBS: members only ----------------------------------------------------
    // The member list is in Firestore (bbsMembers/{uid}); the sysop is in admins/{uid}.
    function bbsIn() {
      return request.auth != null
        && (isAdmin() || firestore.exists(/databases/(default)/documents/bbsMembers/$(request.auth.uid)));
    }
    function bbsMod() {
      return isAdmin()
        || (bbsIn() && firestore.get(/databases/(default)/documents/bbsMembers/$(request.auth.uid)).data.role == 'cosysop');
    }
    // File cabinet: PDF, images, ZIP, text and common office documents, up to 25 MB.
    function cabinetType() {
      return request.resource.contentType.matches(
        'application/pdf|image/.*|application/zip|application/x-zip-compressed|text/plain|text/csv|text/markdown|application/rtf|application/msword|application/vnd[.]ms-excel|application/vnd[.]ms-powerpoint|application/vnd[.]openxmlformats-officedocument[.].*|application/vnd[.]oasis[.]opendocument[.].*');
    }

    // bbs/files/{uid}/{fileId}/{name}: the uploader's own folder.
    match /bbs/files/{uid}/{fileId}/{name} {
      allow read: if bbsIn();
      allow create: if bbsIn() && request.auth.uid == uid
        && request.resource.size <= 25 * 1024 * 1024 && cabinetType();
      allow update: if false;
      allow delete: if bbsIn() && (request.auth.uid == uid || bbsMod());
    }

    // bbs/posts/{uid}/{name}: photos on board posts (shrunk in the browser first).
    match /bbs/posts/{uid}/{name} {
      allow read: if bbsIn();
      allow create: if bbsIn() && request.auth.uid == uid
        && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
      allow update: if false;
      allow delete: if bbsIn() && (request.auth.uid == uid || bbsMod());
    }

    match /{everythingElse=**} {
      allow read, write: if false;
    }
  }
}
