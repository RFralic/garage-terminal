rules_version = '2';

// =============================================================================
// Garage Terminal: Firestore security rules
//
// These rules are the real security. The web pages only *ask*; the rules
// decide. Anything not explicitly allowed here is denied.
//
// Sections: members (users, handles, private, admins) · forum (settings, areas,
// threads, posts) · moderation (reports, modlog) · library · RepClock (per-member workouts) · Home Projects (per-member projects) ·
// Logbook + Project Tracker (per-member records, projects, tracker settings) ·
// Pantry (shared by a household: pantries, items, activity, shopping, invites) ·
// Morning Brief (per-member email settings) · BBS (members-only board, chat and files).
//
// Cloud Functions use the Admin SDK, which bypasses these rules. That's how:
//   - counters (replyCount, lastReplyAt, postCount) are kept up to date, and
//   - every sysop moderation action is made (functions/index.js `moderate`),
//     always together with a modlog entry.
// So the page itself can never change pins, locks, hidden flags, member status
// or settings directly, not even for the sysop.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The sysop is anyone with a doc at admins/{uid}. Those docs are only ever
    // created by hand (Firebase console or the "Add sysop" GitHub action).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Handles: 3–20 letters, numbers or underscores, not a reserved word.
    // Reserved check ignores capitals ("SysOp" is blocked too).
    function reservedHandles() {
      return ['sysop', 'admin', 'moderator', 'garage', 'terminal'];
    }

    function validHandle(h) {
      return h is string
        && h.matches('^[A-Za-z0-9_]{3,20}$')
        && !(h.lower() in reservedHandles());
    }

    // =========================================================================
    // MEMBERS
    // =========================================================================

    // ---------- users/{uid}: public member profile ---------------------------
    // Anyone can read (the forum shows handles). Never holds an email.
    //
    // Created once, when a member claims a handle. In the same write the member
    // must also create handles/{handle} (pointing back at them) and private/{uid}.
    // status, postCount and handle changes are made only by Cloud Functions.
    match /users/{uid} {
      allow read: if true;

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['handle', 'createdAt', 'status', 'postCount'])
        && validHandle(request.resource.data.handle)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'active'
        && request.resource.data.postCount == 0
        // the matching handle reservation must belong to this member
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower())).data.uid == uid
        // and the private email record must be written at the same time
        && existsAfter(/databases/$(database)/documents/private/$(uid));

      // The only field a member may change is their own "last posted" time, and
      // only to *now*, and only if 20+ seconds have passed. Every new thread or
      // reply must update it in the same write, which is how the
      // one-post-per-20-seconds rate limit is enforced.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time
        && (!('lastPostAt' in resource.data)
            || request.time > resource.data.lastPostAt + duration.value(20, 's'));

      allow delete: if false;
    }

    // ---------- handles/{handle}: keeps handles unique -----------------------
    // Doc ID is the handle in lowercase, so "Ryan" and "ryan" collide.
    // Anyone can look up one handle (the live "available?" check). Only the
    // sysop can list them (member search on /mod).
    match /handles/{handle} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if signedIn()
        && validHandle(handle)
        && handle == handle.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // one handle per member: they mustn't already have a profile...
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        // ...and the profile created alongside must use this exact handle
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle.lower() == handle;

      // Creating over an existing doc counts as an update, so a taken handle
      // can never be grabbed. Renames are done by the sysop's Cloud Function.
      allow update, delete: if false;
    }

    // ---------- private/{uid}: email and ban reason, sysop eyes only ---------
    // The member writes their email once (must be the one Google signed them in
    // with). Only the sysop can read it. Other members never can.
    match /private/{uid} {
      allow read: if isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email
        && existsAfter(/databases/$(database)/documents/users/$(uid));

      allow update, delete: if false;
    }

    // ---------- admins/{uid}: who is sysop -----------------------------------
    // A signed-in user may check only their own entry (so the page knows
    // whether to show sysop tools).
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // =========================================================================
    // FORUM
    // =========================================================================

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function site() {
      return get(/databases/$(database)/documents/settings/site).data;
    }

    // Member with a handle and status "active" (muted and banned can't post),
    // and the forum is open (the sysop can always post).
    function canPost() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'active'
        && (isAdmin() || !exists(/databases/$(database)/documents/settings/site) || site().forumOpen != false);
    }

    // Word filter: true if the text contains a banned word (whole words,
    // ignoring capitals). Banned words are limited to letters, numbers and
    // spaces when saved, so they're always safe to put in a pattern.
    function hasBannedWord(text) {
      return exists(/databases/$(database)/documents/settings/site)
        && site().get('bannedWords', []).size() > 0
        && text.lower().matches('(?s).*\\b(' + site().bannedWords.join('|') + ')\\b.*');
    }

    // This write must also bump the member's lastPostAt to now (rate limit).
    function bumpsLastPost() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPostAt == request.time;
    }

    // Author fields on a new thread or post must be the real, current member.
    // authorRole drives the SYSOP badge, so it's checked against admins/.
    function authorFieldsOk(data) {
      return data.authorUid == request.auth.uid
        && data.authorHandle == me().handle
        && data.authorRole == (isAdmin() ? 'sysop' : 'member');
    }

    function validTitle(t) {
      return t is string && t.size() >= 3 && t.size() <= 120 && t.matches('(?s).*\\S.*');
    }

    function validBody(b) {
      return b is string && b.size() >= 1 && b.size() <= 10000 && b.matches('(?s).*\\S.*');
    }

    // ---------- settings/site: sysop notice, forum switch, word filter -------
    // Everyone reads. Changed only through the sysop's Cloud Function (logged).
    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- areas/{id}: [1] General ... [5] Off-Topic --------------------
    // Created by the deploy (scripts/seed.mjs). Read-only from the site.
    match /areas/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- threads/{threadId} -------------------------------------------
    // replyCount and lastReplyAt are kept up to date by Cloud Functions.
    // pinned / locked / hidden / areaId changes are sysop actions (Cloud Function).
    match /threads/{threadId} {
      // Hidden threads are invisible to everyone but the sysop. List queries
      // from the page must include where('hidden', '==', false).
      allow read: if resource.data.hidden == false || isAdmin();

      // A new thread whose title or opening post contains a banned word must be
      // created hidden and "held" for the sysop to review.
      allow create: if canPost()
        && request.resource.data.keys().hasOnly([
             'areaId', 'title', 'authorUid', 'authorHandle', 'authorRole',
             'createdAt', 'lastReplyAt', 'replyCount', 'pinned', 'locked', 'hidden', 'held'])
        && exists(/databases/$(database)/documents/areas/$(request.resource.data.areaId))
        && validTitle(request.resource.data.title)
        && authorFieldsOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastReplyAt == request.time
        && request.resource.data.replyCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && (hasBannedWord(request.resource.data.title + ' '
              + getAfter(/databases/$(database)/documents/threads/$(threadId)/posts/op).data.body)
            ? request.resource.data.hidden == true && request.resource.data.held == true
            : request.resource.data.hidden == false && !('held' in request.resource.data))
        // the opening post (id "op") is written in the same batch
        && existsAfter(/databases/$(database)/documents/threads/$(threadId)/posts/op)
        && bumpsLastPost();

      allow update, delete: if false;

      // ---------- threads/{threadId}/posts/{postId} --------------------------
      // The opening post always has the id "op"; replies get random ids.
      match /posts/{postId} {
        function thread() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data;
        }
        function threadAfter() {
          return getAfter(/databases/$(database)/documents/threads/$(threadId)).data;
        }

        allow read: if isAdmin() || (resource.data.hidden == false && thread().hidden == false);

        // A reply containing a banned word must be created hidden and "held".
        // (An opening post is never held itself; its thread is held instead.)
        allow create: if canPost()
          && request.resource.data.keys().hasOnly([
               'authorUid', 'authorHandle', 'authorRole', 'body', 'createdAt', 'hidden', 'held'])
          && authorFieldsOk(request.resource.data)
          && validBody(request.resource.data.body)
          && request.resource.data.createdAt == request.time
          && bumpsLastPost()
          && (postId == 'op'
                // "op" only together with a brand-new thread by the same author
                ? !exists(/databases/$(database)/documents/threads/$(threadId))
                  && threadAfter().authorUid == request.auth.uid
                  && request.resource.data.hidden == false && !('held' in request.resource.data)
                // replies only to an existing thread that isn't locked or hidden
                : thread().locked == false && thread().hidden == false
                  && (hasBannedWord(request.resource.data.body)
                      ? request.resource.data.hidden == true && request.resource.data.held == true
                      : request.resource.data.hidden == false && !('held' in request.resource.data)));

        // Authors can edit their own post's text within 30 minutes, if the
        // thread isn't locked, they can still post, and the new text passes
        // the word filter.
        allow update: if canPost()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
          && validBody(request.resource.data.body)
          && !hasBannedWord(request.resource.data.body)
          && request.resource.data.editedAt == request.time
          && request.time < resource.data.createdAt + duration.value(30, 'm')
          && thread().locked == false;

        // Authors can delete their own replies. The opening post can't be
        // deleted by members (deleting a whole thread is a sysop action).
        allow delete: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && postId != 'op';
      }
    }

    // Collection-group queries over every thread's posts (member's posts,
    // posts today, held posts) are for the sysop dashboard only.
    match /{path=**}/posts/{postId} {
      allow read: if isAdmin();
    }

    // =========================================================================
    // MODERATION
    // =========================================================================

    // ---------- reports/{reportId}: a member reporting a post ----------------
    // ID is "{threadId}__{postId}__{reporterUid}", so each member can report a
    // given post only once. Muted members may report; banned members can't.
    // Only the sysop reads reports; their status changes via Cloud Function.
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status in ['active', 'muted']
        && request.resource.data.keys().hasOnly([
             'threadId', 'postId', 'reporterUid', 'reporterHandle', 'reason', 'note', 'createdAt', 'status'])
        && reportId == request.resource.data.threadId + '__' + request.resource.data.postId + '__' + request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterHandle == me().handle
        && request.resource.data.reason in ['spam', 'rude', 'off-topic', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        // the post must exist and be visible
        && get(/databases/$(database)/documents/threads/$(request.resource.data.threadId)/posts/$(request.resource.data.postId)).data.hidden == false;

      allow update, delete: if false;
    }

    // ---------- modlog/{id}: every moderation action -------------------------
    // Written only by the moderation Cloud Function. Sysop reads.
    match /modlog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // LIBRARY (wiki)
    // =========================================================================

    // ---------- library/{slug}: a wiki item (uploaded file or written page) --
    // The doc ID is the item's web address (/wiki/{slug}), so addresses are
    // unique. Everyone reads published items; drafts are sysop-only.
    // Only the sysop writes (from /wiki/add). Files live in Storage at
    // library/{slug}/{fileName}; see storage.rules.
    function validLibraryItem(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'slug', 'title', 'folder', 'kind', 'type', 'description', 'body',
               'storagePath', 'fileName', 'size', 'contentType',
               'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.slug == slug
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() <= 80
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 150
        && d.folder in ['guides', 'manuals', 'ebooks', 'files']
        && d.kind in ['file', 'page']
        && d.type in ['PDF', 'EPUB', 'GUIDE', 'MANUAL', 'DOC', 'SHEET', 'IMAGE', 'ZIP', 'TEXT', 'FILE']
        && d.description is string && d.description.size() <= 500
        && d.body is string && d.body.size() <= 100000
        // a file, if any, must be inside this item's own folder in Storage
        && (d.storagePath == '' || d.storagePath.matches('^library/' + slug + '/[^/]+$'))
        && d.size is int && d.size >= 0 && d.size <= 50 * 1024 * 1024
        && (d.kind == 'page' || d.storagePath != '')
        && d.status in ['draft', 'published']
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /library/{slug} {
      // Public list queries must include where('status', '==', 'published').
      allow read: if resource.data.status == 'published' || isAdmin();

      allow create: if isAdmin() && validLibraryItem(slug)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin() && validLibraryItem(slug)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.kind == resource.data.kind;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // REPCLOCK (apps/repclock): each member's own workouts and settings
    // =========================================================================

    // Private to the member: nobody else can read or write them, not even the
    // sysop. Values are the JSON text RepClock keeps on the device
    // (src/apps/repclock-sync.js).
    function optionalText(m, key, max) {
      return !(key in m) || (m[key] is string && m[key].size() <= max);
    }

    match /repclock/{uid} {
      allow read, delete: if isSelf(uid);

      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['settings', 'updatedAt'])
        && request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly(['cfg', 'goals', 'theme', 'muted'])
        && optionalText(request.resource.data.settings, 'cfg', 20000)
        && optionalText(request.resource.data.settings, 'goals', 20000)
        && optionalText(request.resource.data.settings, 'theme', 100)
        && optionalText(request.resource.data.settings, 'muted', 20)
        && request.resource.data.updatedAt == request.time;

      // One doc per saved workout; the ID is RepClock's workout id (a number).
      match /workouts/{workoutId} {
        allow read, delete: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && workoutId.matches('^[0-9]{1,20}$')
          && request.resource.data.keys().hasOnly(['json', 'date', 'updatedAt'])
          && request.resource.data.json is string && request.resource.data.json.size() <= 50000
          && request.resource.data.date is string && request.resource.data.date.size() <= 40
          && request.resource.data.updatedAt == request.time;
      }
    }

    // =========================================================================
    // HOME PROJECTS (apps/home-projects): each member's own projects
    // =========================================================================

    // Private to the member: nobody else can read or write them, not even the
    // sysop. One doc per project, in the app's own format
    // (src/apps/homeprojects-backend.js).
    //
    // Doc kinds (field `kind`): "room" and "project" (with tasks), and
    // "upkeep" for recurring maintenance reminders:
    //   { kind: "upkeep", name, every: 1-999, unit: "days"|"weeks"|"months"|"years",
    //     last: "YYYY-MM-DD" | "" (latest history date), location, part, store, url,
    //     notes, history: [{ id, date: "YYYY-MM-DD", note }] }
    // Next due = last + every × unit; "" last means never logged. The app flags
    // a reminder as due soon within 20% of its interval (3–14 days).
    match /homeprojects/{uid}/projects/{projectId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && projectId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // =========================================================================
    // LOGBOOK (apps/logbook) + PROJECT TRACKER (apps/project-tracker)
    // =========================================================================

    // Private to the member: nobody else can read or write them, not even the
    // sysop. Docs are in the apps' own format (src/apps/logbook-backend.js):
    //   logbook/{uid}/records/{id}          engines, vehicles, parts (inventory)
    //   logbook/{uid}/projects/{id}         Project Tracker projects and jobs
    //   logbook/{uid}/trackerSettings/{id}  Project Tracker counter and shop info
    //   logbook/{uid}/receipts/{id}         a receipt photo or PDF on a part (one file per doc)
    // ---------- shared shop: employees (Garage Terminal shop app) ------------
    // A shop is an owner's Logbook + Job_Board data (logbook/{owner}/...). With Employees
    // switched on (shops/{owner}.on), people the owner invited by email can join it:
    //   shopInvites/{email}           the owner's invite: role + permissions; only the owner
    //                                 and the person with that verified Google email can read it
    //   shops/{owner}                 { on, name, people: [{id, name, role}], options }  (owner writes;
    //                                 members read it for Assigned to / Done by)
    //   shops/{owner}/members/{uid}   made by the invited person when they join; must copy the
    //                                 invite's role, permissions and memberId exactly
    // Removing the member doc, or switching Employees off, cuts access at once.
    // What members may do with the owner's data (see memberWrite below):
    //   everyone   read records, projects and trackerSettings (not 'team'); work jobs
    //              (projects), add machines, log services, take parts off the shelf
    //              (qty only), job numbers and the customer list
    //   inventory  add, change and delete parts and receipts
    //   settings   change shop info (trackerSettings/shop)
    //   deleteJobs delete jobs (each role's permissions are set by the owner in the shop app)
    // Prices and phone numbers live inside the jobs, so hiding them from a role is done
    // on screen, not here.
    function shopPath(o) { return /databases/$(database)/documents/shops/$(o); }
    function memberPath(o) { return /databases/$(database)/documents/shops/$(o)/members/$(request.auth.uid); }
    function shopOn(o) { return exists(shopPath(o)) && get(shopPath(o)).data.on == true; }
    function shopMember(o) { return signedIn() && request.auth.uid != o && exists(memberPath(o)) && shopOn(o); }
    function memberPerm(o, k) { return get(memberPath(o)).data.perms[k] == true; }
    function memberRole(o) { return get(memberPath(o)).data.role; }
    function myEmail() { return request.auth.token.email.lower(); }
    function verifiedEmail() { return signedIn() && request.auth.token.email is string && request.auth.token.email_verified == true; }
    function shopRoles() { return ['tech', 'counter', 'manager']; }
    function validPerms(p) {
      return p is map && p.keys().hasOnly(['prices', 'phones', 'inventory', 'settings', 'deleteJobs', 'approveTime'])
        && p.prices is bool && p.phones is bool && p.inventory is bool && p.settings is bool
        && (!('deleteJobs' in p) || p.deleteJobs is bool) && (!('approveTime' in p) || p.approveTime is bool);
    }
    function onlyQty() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty', 'updatedAt']);
    }
    function memberWrite(o, part, docId) {
      return (part == 'projects')
        || (part == 'records' && (memberPerm(o, 'inventory')
              || (resource == null && request.resource.data.kind != 'part')
              || (resource != null && resource.data.kind != 'part' && request.resource.data.kind != 'part')
              || (resource != null && resource.data.kind == 'part' && onlyQty())))
        || (part == 'trackerSettings' && (docId in ['counter', 'customers'] || (docId == 'shop' && memberPerm(o, 'settings'))));
    }
    function memberDelete(o, part) {
      return (part == 'projects' && memberPerm(o, 'deleteJobs'))
        || (part in ['records', 'receipts'] && memberPerm(o, 'inventory'));
    }
    function validReceipt() {
      return request.resource.data.keys().hasOnly(['partId', 'name', 'type', 'data', 'size', 'createdAt'])
        && request.resource.data.partId is string && request.resource.data.partId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.type in ['image', 'pdf']
        && request.resource.data.data is string && request.resource.data.data.size() <= 1000000
        && request.resource.data.size is int
        && request.resource.data.createdAt is string;
    }

    match /logbook/{uid}/{part}/{docId} {
      allow read: if part in ['records', 'projects', 'trackerSettings', 'receipts']
        && (isSelf(uid) || (shopMember(uid) && !(part == 'trackerSettings' && docId == 'team')));
      allow delete: if (isSelf(uid) && part in ['records', 'projects', 'trackerSettings', 'receipts'])
        || (shopMember(uid) && memberDelete(uid, part));
      allow create, update: if part in ['records', 'projects', 'trackerSettings']
        && docId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data is map
        && (isSelf(uid) || (shopMember(uid) && memberWrite(uid, part, docId)));
      // Receipts: only these fields; the file is a data: URL string (a shrunk JPEG
      // photo or a small PDF), kept under Firestore's 1 MiB doc limit.
      allow create, update: if part == 'receipts'
        && docId.matches('^[A-Za-z0-9_-]{1,64}$')
        && validReceipt()
        && (isSelf(uid) || (shopMember(uid) && memberPerm(uid, 'inventory')));
    }

    match /shops/{o} {
      allow read: if isSelf(o) || (signedIn() && exists(memberPath(o)));
      allow create, update: if isSelf(o)
        && request.resource.data.keys().hasOnly(['on', 'name', 'people', 'options', 'updatedAt'])
        && request.resource.data.on is bool
        && (!('people' in request.resource.data) || (request.resource.data.people is list && request.resource.data.people.size() <= 50))
        && (!('options' in request.resource.data) || request.resource.data.options is map)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80;
      allow delete: if isSelf(o);

      match /members/{m} {
        allow read: if isSelf(o) || isSelf(m);
        allow delete: if isSelf(o) || isSelf(m); // the owner removes; a member can leave
        allow update: if isSelf(o)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'perms', 'name'])
          && request.resource.data.role in shopRoles()
          && validPerms(request.resource.data.perms)
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        // Joining: only the invited Google account, copying its invite exactly.
        allow create: if isSelf(m) && m != o && verifiedEmail()
          && exists(/databases/$(database)/documents/shopInvites/$(myEmail()))
          && get(/databases/$(database)/documents/shopInvites/$(myEmail())).data.owner == o
          && request.resource.data.keys().hasOnly(['email', 'name', 'role', 'perms', 'memberId', 'joinedAt'])
          && request.resource.data.email == myEmail()
          && request.resource.data.role == get(/databases/$(database)/documents/shopInvites/$(myEmail())).data.role
          && request.resource.data.perms == get(/databases/$(database)/documents/shopInvites/$(myEmail())).data.perms
          && request.resource.data.memberId == get(/databases/$(database)/documents/shopInvites/$(myEmail())).data.memberId
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.joinedAt == request.time;
      }
    }

    // shopInvites/{email}: one shop per email; a second owner can't take over someone else's invite.
    match /shopInvites/{email} {
      allow read: if (signedIn() && resource.data.owner == request.auth.uid)
        || (verifiedEmail() && myEmail() == email);
      allow create, update: if signedIn()
        && email.matches('^[^@/\\s]+@[^@/\\s]+[.][^@/\\s]+$') && email == email.lower()
        && request.resource.data.owner == request.auth.uid
        && (resource == null || resource.data.owner == request.auth.uid)
        && request.resource.data.keys().hasOnly(['owner', 'ownerName', 'shopName', 'memberId', 'name', 'role', 'perms', 'updatedAt'])
        && request.resource.data.role in shopRoles()
        && validPerms(request.resource.data.perms)
        && request.resource.data.memberId is string && request.resource.data.memberId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.ownerName is string && request.resource.data.ownerName.size() <= 80
        && request.resource.data.shopName is string && request.resource.data.shopName.size() <= 80;
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;
    }

    // =========================================================================
    // PANTRY (apps/pantry): food and supplies, shared by a household
    // =========================================================================

    // Unlike the other apps, a pantry belongs to several people. The pantry doc
    // lists them, each with a role:
    //   owner   (one, the person who started it): invite, change roles, remove
    //           people, rename, use-by defaults
    //   member  scan in and out, add and edit items, homemade batches
    //   viewer  read everything; may add to and tick off the shopping list
    //
    //   pantries/{pid}            { name, owner, members: {uid: role}, memberIds: [uid],
    //                               memberNames: {uid: name}, nextBatch, useBy: {method: months},
    //                               inviteCode, inviteExpires, joinCode, createdAt, updatedAt }
    //   pantries/{pid}/items/{id}     one food or supply item (src/pantry/store.js)
    //   pantries/{pid}/activity/{id}  who did what; added, never edited
    //   pantries/{pid}/shopping/{id}  things added to the shopping list by hand
    //   pantryInvites/{code}      { pantryId, pantryName, createdBy, expiresAt }
    //
    // Joining: the owner makes an 8-character invite code (pantryInvites/{code}
    // plus inviteCode/inviteExpires on the pantry). Someone with the code reads
    // the invite to learn which pantry, then adds only themselves, as a member,
    // quoting the code; the rule checks it matches and hasn't expired.
    // Codes can't be listed, only looked up exactly.
    function pantryRoles() {
      return ['owner', 'member', 'viewer'];
    }

    function validPantry(d) {
      return d.keys().hasOnly(['name', 'owner', 'members', 'memberIds', 'memberNames', 'nextBatch', 'useBy',
                               'inviteCode', 'inviteExpires', 'joinCode', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 60
        && d.owner is string
        && d.members is map && d.memberIds is list
        && d.memberIds.size() >= 1 && d.memberIds.size() <= 20
        && d.memberIds.size() == d.members.size()
        && d.memberIds.toSet() == d.members.keys().toSet()
        && d.members.values().toSet().hasOnly(pantryRoles())
        && d.members[d.owner] == 'owner'
        && d.memberNames is map && d.memberNames.keys().hasOnly(d.memberIds)
        && d.nextBatch is int && d.nextBatch >= 0 && d.nextBatch <= 9999999
        && (!('useBy' in d) || (d.useBy is map && d.useBy.size() <= 20))
        && (!('inviteCode' in d) || (d.inviteCode is string && (d.inviteCode == '' || d.inviteCode.matches('^[A-Z0-9]{8}$'))))
        && (!('inviteExpires' in d) || d.inviteExpires is timestamp);
    }

    function pantryRole(pid) {
      return get(/databases/$(database)/documents/pantries/$(pid)).data.members[request.auth.uid];
    }
    function canReadPantry(pid) {
      return signedIn() && pantryRole(pid) in pantryRoles();
    }
    function canEditPantry(pid) {
      return signedIn() && pantryRole(pid) in ['owner', 'member'];
    }

    // The owner changes settings, invites, roles and who's in it (never the owner itself).
    function pantryOwnerUpdate(d, r) {
      return r.owner == request.auth.uid
        && d.owner == r.owner
        && !d.diff(r).affectedKeys().hasAny(['createdAt', 'joinCode'])
        && d.nextBatch >= r.nextBatch
        && validPantry(d);
    }

    // A member or the owner takes the next homemade batch number.
    function pantryBatchBump(d, r) {
      return r.members[request.auth.uid] in ['owner', 'member']
        && d.diff(r).affectedKeys().hasOnly(['nextBatch'])
        && d.nextBatch == r.nextBatch + 1;
    }

    // Someone with a valid invite code adds themselves, as a member.
    function pantryJoin(d, r) {
      let me = request.auth.uid;
      return !(me in r.memberIds)
        && r.memberIds.size() < 20
        && 'inviteCode' in r && r.inviteCode is string && r.inviteCode != ''
        && d.joinCode == r.inviteCode
        && 'inviteExpires' in r && r.inviteExpires > request.time
        && d.diff(r).affectedKeys().hasOnly(['members', 'memberIds', 'memberNames', 'joinCode'])
        && d.members.diff(r.members).affectedKeys().hasOnly([me]) && d.members[me] == 'member'
        && d.memberIds.toSet() == r.memberIds.toSet().union([me].toSet())
        && d.memberIds.size() == r.memberIds.size() + 1
        && d.memberNames.diff(r.memberNames).affectedKeys().hasOnly([me])
        && (!(me in d.memberNames) || (d.memberNames[me] is string && d.memberNames[me].size() <= 40));
    }

    // Anyone but the owner can leave.
    function pantryLeave(d, r) {
      let me = request.auth.uid;
      return me in r.memberIds && r.owner != me
        && d.diff(r).affectedKeys().hasOnly(['members', 'memberIds', 'memberNames'])
        && !(me in d.members)
        && d.members.diff(r.members).affectedKeys().hasOnly([me])
        && d.memberIds.toSet() == r.memberIds.toSet().difference([me].toSet())
        && d.memberIds.size() == r.memberIds.size() - 1
        && d.memberNames.diff(r.memberNames).affectedKeys().hasOnly([me]);
    }

    match /pantries/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && pid.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.nextBatch == 0
        && !('inviteCode' in request.resource.data)
        && !('joinCode' in request.resource.data)
        && request.resource.data.createdAt == request.time
        && validPantry(request.resource.data);

      allow update: if signedIn()
        && (pantryOwnerUpdate(request.resource.data, resource.data)
            || pantryBatchBump(request.resource.data, resource.data)
            || pantryJoin(request.resource.data, resource.data)
            || pantryLeave(request.resource.data, resource.data));

      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      match /items/{itemId} {
        allow read: if canReadPantry(pid);
        allow delete: if canEditPantry(pid);
        allow create, update: if canEditPantry(pid)
          && itemId.matches('^[A-Za-z0-9_-]{1,64}$')
          && request.resource.data.keys().hasOnly(['name', 'brand', 'size', 'location', 'keepAtLeast', 'barcodes', 'lots',
                                                   'photo', 'notes', 'homemade', 'createdAt', 'updatedAt', 'updatedBy'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
          && request.resource.data.lots is list && request.resource.data.lots.size() <= 50
          && request.resource.data.barcodes is list && request.resource.data.barcodes.size() <= 20
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
      }

      match /activity/{entryId} {
        allow read: if canReadPantry(pid);
        allow create: if canReadPantry(pid)
          && request.resource.data.keys().hasOnly(['by', 'who', 'what', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.who is string && request.resource.data.who.size() <= 40
          && request.resource.data.what is string && request.resource.data.what.size() <= 200
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && pantryRole(pid) == 'owner';
      }

      match /shopping/{entryId} {
        allow read, delete: if canReadPantry(pid);
        allow create, update: if canReadPantry(pid)
          && request.resource.data.keys().hasOnly(['name', 'done', 'by', 'who', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 120
          && request.resource.data.done is bool;
      }
    }

    match /pantryInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{8}$')
        && request.resource.data.keys().hasOnly(['pantryId', 'pantryName', 'createdBy', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.pantryName is string && request.resource.data.pantryName.size() <= 60
        && request.resource.data.expiresAt is timestamp
        && get(/databases/$(database)/documents/pantries/$(request.resource.data.pantryId)).data.owner == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // =========================================================================
    // MORNING BRIEF (apps/morning-brief): each member's daily email settings
    // =========================================================================

    // briefs/{uid}: the member's own settings. The email can only ever be the
    // member's own verified Google address, so nobody can send briefs to
    // someone else. The calendar address is secret, so only the member can
    // read it. Sent by scripts/send-briefs.mjs (Admin SDK).
    function briefSections(s) {
      return s is map
        && s.keys().hasOnly(['today', 'upcoming', 'lowStock', 'maintenance', 'projects', 'pantryExpiring', 'pantryShopping', 'customerJobs'])
        && (!('today' in s) || s.today is bool)
        && (!('upcoming' in s) || s.upcoming is bool)
        && (!('lowStock' in s) || s.lowStock is bool)
        && (!('maintenance' in s) || s.maintenance is bool)
        && (!('projects' in s) || s.projects is bool)
        && (!('pantryExpiring' in s) || s.pantryExpiring is bool)
        && (!('pantryShopping' in s) || s.pantryShopping is bool)
        && (!('customerJobs' in s) || s.customerJobs is bool);
    }

    match /briefs/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['enabled', 'email', 'hour', 'tz', 'icsUrl', 'sections', 'sendNow', 'updatedAt', 'frequency', 'weekday', 'mode', 'aheadDays'])
        && (!('aheadDays' in request.resource.data) || request.resource.data.aheadDays in [3, 7, 14, 21, 30, 60])
        && (!('mode' in request.resource.data) || request.resource.data.mode in ['brief', 'maintenance'])
        && (!('frequency' in request.resource.data) || request.resource.data.frequency in ['daily', 'weekly'])
        && (!('weekday' in request.resource.data)
            || (request.resource.data.weekday is int && request.resource.data.weekday >= 0 && request.resource.data.weekday <= 6))
        && request.resource.data.enabled is bool
        && request.auth.token.email_verified == true
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.hour is int
        && request.resource.data.hour >= 0 && request.resource.data.hour <= 23
        && request.resource.data.tz is string && request.resource.data.tz.size() <= 64
        && request.resource.data.icsUrl is string && request.resource.data.icsUrl.size() <= 2000
        && (request.resource.data.icsUrl == '' || request.resource.data.icsUrl.matches('^https://.+'))
        && briefSections(request.resource.data.sections)
        && request.resource.data.sendNow is bool
        && request.resource.data.updatedAt == request.time;
    }

    // briefStatus/{uid}: when the last brief went out, or why it didn't.
    // Written only by the sender.
    match /briefStatus/{uid} {
      allow read: if isSelf(uid);
    }

    // =========================================================================
    // BBS (/bbs): the private, members-only board, reached through the >_ door
    // =========================================================================
    //
    // Who gets in: the sysop (admins/), and anyone with a bbsMembers/{uid} doc.
    // Every BBS read checks that doc, so removing a member cuts them off at once.
    // The member list, denials, removals and BBS settings are changed only by the
    // `bbs` Cloud Function (functions/bbs.js), which checks sysop / co-sysop
    // powers and writes the mod log. From the page a person can only ask to join
    // (create their own request) or take the request back.
    //
    //   bbsConfig/main        { doorWord, requirePasscode, notice }  everyone reads
    //   bbsRequests/{uid}     { handle, createdAt }                  one per account
    //   bbsMembers/{uid}      { handle, role: member|cosysop|sysop, since, addedBy, lastSeen, mutedUntil? }
    //   bbsDenied/{uid}       { handle, at, until, by }              30-day wait
    //   bbsRemoved/{uid}      { handle, at, by }
    //   bbsKnocks/{uid}       passcode tries (Cloud Function only)
    // No BBS doc ever holds an email address.

    function bbsMember() {
      return signedIn() && exists(/databases/$(database)/documents/bbsMembers/$(request.auth.uid));
    }
    function bbsMe() {
      return get(/databases/$(database)/documents/bbsMembers/$(request.auth.uid)).data;
    }
    // Inside the BBS: the sysop, or an approved member.
    function bbsIn() {
      return isAdmin() || bbsMember();
    }
    // Sysop or co-sysop (approve people, moderate posts and chat).
    function bbsMod() {
      return isAdmin() || (bbsMember() && bbsMe().role == 'cosysop');
    }
    function bbsConfig() {
      return get(/databases/$(database)/documents/bbsConfig/main).data;
    }
    function bbsPasscodeOn() {
      return exists(/databases/$(database)/documents/bbsConfig/main)
        && bbsConfig().get('requirePasscode', false) == true;
    }

    // The door word and the sysop notice. Readable signed out too, so the door works.
    match /bbsConfig/{id} {
      allow read: if true;
      allow write: if false;
    }

    // A request to join. The doc ID is the person's uid, so there is only ever one.
    // Not allowed for members, while a denial's 30-day wait is running, or when the
    // passcode is switched on (then the bbsKnock Cloud Function files the request
    // after a correct code).
    match /bbsRequests/{uid} {
      allow get: if isSelf(uid) || bbsMod();
      allow list: if bbsMod();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['handle', 'createdAt'])
        && exists(/databases/$(database)/documents/users/$(uid))
        && request.resource.data.handle == me().handle
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/bbsMembers/$(uid))
        && (!exists(/databases/$(database)/documents/bbsDenied/$(uid))
            || get(/databases/$(database)/documents/bbsDenied/$(uid)).data.until < request.time)
        && !bbsPasscodeOn();
      allow delete: if isSelf(uid);
      allow update: if false;
    }

    // Members: the Crew list inside the BBS. A member may only stamp their own
    // "last seen" (presence), and only with the server time.
    match /bbsMembers/{uid} {
      allow get: if isSelf(uid) || bbsIn();
      allow list: if bbsIn();
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
        && request.resource.data.lastSeen == request.time;
      allow create, delete: if false;
    }

    // Denied: the person can see their own (so the page can say when they may ask again).
    match /bbsDenied/{uid} {
      allow get: if isSelf(uid) || bbsMod();
      allow list: if bbsMod();
      allow write: if false;
    }

    match /bbsRemoved/{uid} {
      allow read: if bbsMod();
      allow write: if false;
    }

    match /bbsKnocks/{uid} {
      allow read, write: if false;
    }

    // ---------- boards, threads, posts (part 2) ------------------------------------------
    //   bbsBoards/{id}         { name, description, order, archived, createdAt }  sysop, via `bbs`
    //   bbsThreads/{id}        { boardId, title, authorUid, authorHandle, createdAt, lastAt, lastBy,
    //                            replyCount, pinned, locked }
    //   bbsThreads/{id}/posts/{postId}  { authorUid, authorHandle, body, photo?, createdAt, editedAt? }
    //                          the opening post has the id "op", written together with its thread
    //   bbsReads/{uid}         { boards: { boardId: when }, files: when, chat: when }  your own "last visit" marks
    //   bbsFiles/{id}          the file cabinet: { title, titleLower, note, name, type, size,
    //                            contentType, path, byUid, byHandle, createdAt }
    // replyCount / lastAt / lastBy are kept by Cloud Functions (functions/bbs-content.js), which
    // also clean up a deleted thread's posts and photos, and a deleted file's upload.

    function bbsBoardOpen(boardId) {
      return exists(/databases/$(database)/documents/bbsBoards/$(boardId))
        && get(/databases/$(database)/documents/bbsBoards/$(boardId)).data.archived == false;
    }
    function bbsText(t, min, max) {
      return t is string && t.size() >= min && t.size() <= max;
    }
    // A post's photo, if any, is one the author uploaded to their own folder.
    function bbsPhotoOk(d) {
      return !('photo' in d) || (d.photo is map
        && d.photo.keys().hasOnly(['path', 'w', 'h'])
        && d.photo.path is string && d.photo.path.matches('^bbs/posts/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,100}$')
        && d.photo.w is int && d.photo.h is int);
    }

    match /bbsBoards/{boardId} {
      allow read: if bbsIn();
      allow write: if false;
    }

    match /bbsThreads/{threadId} {
      allow read: if bbsIn();

      allow create: if bbsIn()
        && request.resource.data.keys().hasOnly([
             'boardId', 'title', 'authorUid', 'authorHandle', 'createdAt', 'lastAt', 'lastBy',
             'replyCount', 'pinned', 'locked', 'saved'])
        && bbsBoardOpen(request.resource.data.boardId)
        && bbsText(request.resource.data.title, 1, 120)
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorHandle == me().handle
        && request.resource.data.lastBy == me().handle
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastAt == request.time
        && request.resource.data.replyCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && (!('saved' in request.resource.data) || request.resource.data.saved == true)
        && existsAfter(/databases/$(database)/documents/bbsThreads/$(threadId)/posts/op);

      // The author can retitle; the sysop and co-sysops pin and lock.
      allow update: if bbsIn() && (
        (resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
          && bbsText(request.resource.data.title, 1, 120))
        || (bbsMod() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pinned', 'locked'])
          && request.resource.data.pinned is bool && request.resource.data.locked is bool));

      // Deleting a thread removes its posts too (Cloud Function).
      allow delete: if bbsIn() && (resource.data.authorUid == request.auth.uid || bbsMod());

      match /posts/{postId} {
        function thread() {
          return get(/databases/$(database)/documents/bbsThreads/$(threadId)).data;
        }
        allow read: if bbsIn();

        allow create: if bbsIn()
          && request.resource.data.keys().hasOnly(['authorUid', 'authorHandle', 'body', 'photo', 'createdAt', 'saved'])
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.authorHandle == me().handle
          && bbsText(request.resource.data.body, 0, 10000)
          && (request.resource.data.body.matches('(?s).*\\S.*') || 'photo' in request.resource.data)
          && bbsPhotoOk(request.resource.data)
          && request.resource.data.createdAt == request.time
          && (postId == 'op'
                // the opening post comes with a brand-new thread by the same person
                ? !exists(/databases/$(database)/documents/bbsThreads/$(threadId))
                  && getAfter(/databases/$(database)/documents/bbsThreads/$(threadId)).data.authorUid == request.auth.uid
                  && bbsSavedOk(request.resource.data,
                       getAfter(/databases/$(database)/documents/bbsThreads/$(threadId)).data.get('saved', false))
                // replies go to an open thread on a board that isn't archived
                : !('saved' in request.resource.data)
                  && thread().locked == false && bbsBoardOpen(thread().boardId));

        // Authors edit their own text / photo while the thread is open.
        allow update: if bbsIn()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'photo', 'editedAt'])
          && bbsText(request.resource.data.body, 0, 10000)
          && bbsPhotoOk(request.resource.data)
          && request.resource.data.editedAt == request.time
          && thread().locked == false;

        // Replies: the author, or the sysop / co-sysops. (The opening post goes with its thread.)
        allow delete: if bbsIn() && postId != 'op'
          && (resource.data.authorUid == request.auth.uid || bbsMod());
      }
    }

    // Threads saved from Shop Talk are written only by the `bbs` Cloud Function (chat.save),
    // which copies the message and its photo and credits whoever said it. From the page,
    // nothing may claim to be saved.
    function bbsSavedOk(d, threadSaved) {
      return !('saved' in d) && threadSaved == false;
    }

    // ---------- Shop Talk (part 3) ---------------------------------------------------------
    //   bbsChat/{id}     { uid, handle, kind: 'msg'|'join', text, photo?, link?, reply?, createdAt,
    //                      savedTo? }  deleted after 7 days by the bbsChatCleanup Cloud Function
    //   bbsTyping/{uid}  { handle, at }  "[handle] is typing"
    // Muted members (bbsMembers mutedUntil in the future) can read but not send. savedTo is
    // set by the `bbs` Cloud Function when a message is saved to a board.

    function bbsCanTalk() {
      return isAdmin()
        || bbsMe().get('mutedUntil', null) == null
        || bbsMe().mutedUntil < request.time;
    }
    function chatPhotoOk(d) {
      return !('photo' in d) || (d.photo is map
        && d.photo.keys().hasOnly(['path', 'w', 'h'])
        && d.photo.path is string && d.photo.path.matches('^bbs/chat/' + request.auth.uid + '/[A-Za-z0-9_.-]{1,100}$')
        && d.photo.w is int && d.photo.h is int);
    }

    match /bbsChat/{msgId} {
      allow read: if bbsIn();
      allow create: if bbsIn() && bbsCanTalk()
        && request.resource.data.keys().hasOnly(['uid', 'handle', 'kind', 'text', 'photo', 'link', 'reply', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.handle == me().handle
        && request.resource.data.createdAt == request.time
        && request.resource.data.kind in ['msg', 'join']
        && bbsText(request.resource.data.text, 0, 2000)
        && (request.resource.data.kind == 'join'
              ? request.resource.data.text == '' && request.resource.data.keys().hasOnly(['uid', 'handle', 'kind', 'text', 'createdAt'])
              : (request.resource.data.text.matches('(?s).*\\S.*') || 'photo' in request.resource.data)
                && chatPhotoOk(request.resource.data)
                && (!('link' in request.resource.data) || bbsText(request.resource.data.link, 1, 500))
                && (!('reply' in request.resource.data)
                    || (request.resource.data.reply is map
                        && request.resource.data.reply.keys().hasOnly(['who', 'text'])
                        && bbsText(request.resource.data.reply.who, 1, 20)
                        && bbsText(request.resource.data.reply.text, 0, 140))));
      allow update: if false;
      allow delete: if bbsMod();
    }

    match /bbsTyping/{uid} {
      allow read: if bbsIn();
      allow create, update: if isSelf(uid) && bbsIn() && bbsCanTalk()
        && request.resource.data.keys().hasOnly(['handle', 'at'])
        && request.resource.data.handle == me().handle
        && request.resource.data.at == request.time;
      allow delete: if isSelf(uid);
    }

    // ---------- private messages (direct messages between two members) ---------------------
    //   bbsDms/{convId}   convId = the two uids, sorted, joined by "_"
    //     { members: [uidA, uidB], handles: { uid: handle }, lastAt, lastText, lastBy, lastId,
    //       readAt: { uid: when }, hidden: { uid: when } }
    //   bbsDms/{convId}/messages/{id}  { uid, handle, text: '', enc: { v, iv, ct, k }, photo?: { w, h }, createdAt }
    //   bbsDms/{convId}/blobs/{id}     { uid, iv, data (bytes), createdAt }  a message's sealed photo
    // Only the two members can read or write, not even the sysop. Both must still be in the
    // BBS (removed members lose access at once; nobody can message them). Muted members can't
    // send. You may delete your own messages; nobody edits them. Kept until deleted.
    // End-to-end encrypted since Nov 24, 2026 (src/bbs/e2e.js): new messages must be sealed
    // (text empty, words in enc.ct) and lastText can only be a fixed placeholder, so nothing
    // readable is stored. Older plain messages stay readable by the two members.

    function dmMember(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid))
        || exists(/databases/$(database)/documents/bbsMembers/$(uid));
    }
    function dmIn(convId) {
      return bbsIn() && request.auth.uid in get(/databases/$(database)/documents/bbsDms/$(convId)).data.members;
    }
    function dmOther(members) {
      return members[0] == request.auth.uid ? members[1] : members[0];
    }
    // A map change that only touches my own key.
    function onlyMyKey(after, before) {
      return after is map && after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
    }

    // A sealed message body: version 1, a 12-byte nonce, the sealed words, and the lock id
    // of each member (sorted-member order). Only the two members' devices can open it.
    function dmSealed(e) {
      return e is map && e.keys().hasOnly(['v', 'iv', 'ct', 'k'])
        && e.v == 1
        && bbsText(e.iv, 16, 16)
        && bbsText(e.ct, 24, 12000)
        && e.k is list && e.k.size() == 2
        && bbsText(e.k[0], 16, 16) && bbsText(e.k[1], 16, 16);
    }

    match /bbsDms/{convId} {
      // List queries must use where('members', 'array-contains', <my uid>).
      allow read: if bbsIn() && request.auth.uid in resource.data.members;

      allow create: if bbsIn() && bbsCanTalk()
        && request.resource.data.keys().hasOnly(['members', 'handles', 'lastAt', 'lastText', 'lastBy', 'lastId', 'readAt', 'hidden'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && convId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && dmMember(dmOther(request.resource.data.members))
        && request.resource.data.handles is map
        && request.resource.data.handles.keys().hasOnly(request.resource.data.members)
        && request.resource.data.handles[request.auth.uid] == me().handle
        && request.resource.data.lastBy == request.auth.uid
        && request.resource.data.lastAt == request.time
        && request.resource.data.lastText == ''
        && request.resource.data.readAt is map && request.resource.data.readAt.keys().hasOnly([request.auth.uid])
        && request.resource.data.hidden is map && request.resource.data.hidden.size() == 0;

      // Either member: a new last message (as themselves, now), their own read mark, or
      // hiding the conversation from their own list.
      allow update: if bbsIn() && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAt', 'lastText', 'lastBy', 'lastId', 'readAt', 'hidden'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastAt', 'lastBy'])
            || (request.resource.data.lastBy == request.auth.uid && request.resource.data.lastAt == request.time
                && bbsCanTalk() && dmMember(dmOther(resource.data.members))))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastText'])
            || request.resource.data.lastText in ['Encrypted message', 'Message deleted'])
        && onlyMyKey(request.resource.data.readAt, resource.data.readAt)
        && onlyMyKey(request.resource.data.hidden, resource.data.hidden);

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if dmIn(convId);
        allow create: if dmIn(convId) && bbsCanTalk()
          && dmMember(dmOther(get(/databases/$(database)/documents/bbsDms/$(convId)).data.members))
          && request.resource.data.keys().hasOnly(['uid', 'handle', 'text', 'enc', 'photo', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.handle == me().handle
          && request.resource.data.createdAt == request.time
          && request.resource.data.text == ''
          && dmSealed(request.resource.data.enc)
          && (!('photo' in request.resource.data) || (request.resource.data.photo is map
               && request.resource.data.photo.keys().hasOnly(['w', 'h'])
               && request.resource.data.photo.w is int && request.resource.data.photo.h is int
               && existsAfter(/databases/$(database)/documents/bbsDms/$(convId)/blobs/$(msgId))));
        allow update: if false;
        allow delete: if dmIn(convId) && resource.data.uid == request.auth.uid;
      }

      // A message's photo, sealed. Written in the same batch as its message.
      match /blobs/{msgId} {
        allow read: if dmIn(convId);
        allow create: if dmIn(convId) && bbsCanTalk()
          && request.resource.data.keys().hasOnly(['uid', 'iv', 'data', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && bbsText(request.resource.data.iv, 16, 16)
          && request.resource.data.data is bytes
          && request.resource.data.data.size() > 0 && request.resource.data.data.size() <= 750 * 1024;
        allow update: if false;
        allow delete: if dmIn(convId) && resource.data.uid == request.auth.uid;
      }
    }

    // ---------- message locks (end-to-end encryption, src/bbs/keys.js) --------------------
    //   bbsKeys/{uid}        { x, y, kid, at }  the public half; any member can read it
    //   bbsKeyBackups/{uid}  { kid, v, iter, salt, iv, ct, at }  the private half, scrambled
    //                        with the member's passphrase; only they can read it
    // Only the member themself writes either one (not even the sysop through the app).
    match /bbsKeys/{uid} {
      allow read: if bbsIn();
      allow create, update: if isSelf(uid) && bbsIn()
        && request.resource.data.keys().hasOnly(['x', 'y', 'kid', 'at'])
        && bbsText(request.resource.data.x, 43, 43) && bbsText(request.resource.data.y, 43, 43)
        && bbsText(request.resource.data.kid, 16, 16)
        && request.resource.data.at == request.time;
      allow delete: if isSelf(uid);
    }
    match /bbsKeyBackups/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && bbsIn()
        && request.resource.data.keys().hasOnly(['kid', 'v', 'iter', 'salt', 'iv', 'ct', 'at'])
        && bbsText(request.resource.data.kid, 16, 16)
        && request.resource.data.v == 1
        && request.resource.data.iter is int && request.resource.data.iter >= 100000
        && bbsText(request.resource.data.salt, 24, 24) && bbsText(request.resource.data.iv, 16, 16)
        && bbsText(request.resource.data.ct, 100, 600)
        && request.resource.data.at == request.time;
    }

    match /bbsReads/{uid} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && bbsIn()
        && request.resource.data.keys().hasOnly(['boards', 'files', 'chat'])
        && (!('boards' in request.resource.data) || request.resource.data.boards is map)
        && (!('files' in request.resource.data) || request.resource.data.files is timestamp)
        && (!('chat' in request.resource.data) || request.resource.data.chat is timestamp);
    }

    // The file cabinet. The upload itself is checked by storage.rules (members, 25 MB).
    match /bbsFiles/{fileId} {
      allow read: if bbsIn();
      allow create: if bbsIn()
        && request.resource.data.keys().hasOnly(['title', 'titleLower', 'note', 'name', 'type', 'size', 'contentType', 'path', 'byUid', 'byHandle', 'createdAt'])
        && bbsText(request.resource.data.title, 1, 120)
        && request.resource.data.titleLower == request.resource.data.title.lower()
        && bbsText(request.resource.data.note, 0, 500)
        && bbsText(request.resource.data.name, 1, 200)
        && bbsText(request.resource.data.type, 1, 8)
        && request.resource.data.size is int && request.resource.data.size > 0 && request.resource.data.size <= 25 * 1024 * 1024
        && bbsText(request.resource.data.contentType, 0, 120)
        && request.resource.data.path.matches('^bbs/files/' + request.auth.uid + '/' + fileId + '/[^/]{1,200}$')
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.byHandle == me().handle
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // The uploader, or the sysop / co-sysops. The upload is deleted with it (Cloud Function).
      allow delete: if bbsIn() && (resource.data.byUid == request.auth.uid || bbsMod());
    }
  }
}
