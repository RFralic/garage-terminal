rules_version = '2';

// =============================================================================
// Garage Terminal: Firestore security rules
//
// These rules are the real security. The web pages only *ask*; the rules
// decide. Anything not explicitly allowed here is denied.
//
// Sections: members (users, handles, private, admins) · forum (settings, areas,
// threads, posts) · moderation (reports, modlog) · library · RepClock (per-member workouts) · Home Projects (per-member projects) ·
// Logbook + Project Tracker (per-member records, projects, tracker settings).
//
// Cloud Functions use the Admin SDK, which bypasses these rules. That's how:
//   - counters (replyCount, lastReplyAt, postCount) are kept up to date, and
//   - every sysop moderation action is made (functions/index.js `moderate`),
//     always together with a modlog entry.
// So the page itself can never change pins, locks, hidden flags, member status
// or settings directly, not even for the sysop.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The sysop is anyone with a doc at admins/{uid}. Those docs are only ever
    // created by hand (Firebase console or the "Add sysop" GitHub action).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Handles: 3–20 letters, numbers or underscores, not a reserved word.
    // Reserved check ignores capitals ("SysOp" is blocked too).
    function reservedHandles() {
      return ['sysop', 'admin', 'moderator', 'garage', 'terminal'];
    }

    function validHandle(h) {
      return h is string
        && h.matches('^[A-Za-z0-9_]{3,20}$')
        && !(h.lower() in reservedHandles());
    }

    // =========================================================================
    // MEMBERS
    // =========================================================================

    // ---------- users/{uid}: public member profile ---------------------------
    // Anyone can read (the forum shows handles). Never holds an email.
    //
    // Created once, when a member claims a handle. In the same write the member
    // must also create handles/{handle} (pointing back at them) and private/{uid}.
    // status, postCount and handle changes are made only by Cloud Functions.
    match /users/{uid} {
      allow read: if true;

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['handle', 'createdAt', 'status', 'postCount'])
        && validHandle(request.resource.data.handle)
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'active'
        && request.resource.data.postCount == 0
        // the matching handle reservation must belong to this member
        && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle.lower())).data.uid == uid
        // and the private email record must be written at the same time
        && existsAfter(/databases/$(database)/documents/private/$(uid));

      // The only field a member may change is their own "last posted" time, and
      // only to *now*, and only if 20+ seconds have passed. Every new thread or
      // reply must update it in the same write, which is how the
      // one-post-per-20-seconds rate limit is enforced.
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastPostAt'])
        && request.resource.data.lastPostAt == request.time
        && (!('lastPostAt' in resource.data)
            || request.time > resource.data.lastPostAt + duration.value(20, 's'));

      allow delete: if false;
    }

    // ---------- handles/{handle}: keeps handles unique -----------------------
    // Doc ID is the handle in lowercase, so "Ryan" and "ryan" collide.
    // Anyone can look up one handle (the live "available?" check). Only the
    // sysop can list them (member search on /mod).
    match /handles/{handle} {
      allow get: if true;
      allow list: if isAdmin();

      allow create: if signedIn()
        && validHandle(handle)
        && handle == handle.lower()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        // one handle per member: they mustn't already have a profile...
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        // ...and the profile created alongside must use this exact handle
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.handle.lower() == handle;

      // Creating over an existing doc counts as an update, so a taken handle
      // can never be grabbed. Renames are done by the sysop's Cloud Function.
      allow update, delete: if false;
    }

    // ---------- private/{uid}: email and ban reason, sysop eyes only ---------
    // The member writes their email once (must be the one Google signed them in
    // with). Only the sysop can read it. Other members never can.
    match /private/{uid} {
      allow read: if isAdmin();

      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email'])
        && request.resource.data.email == request.auth.token.email
        && existsAfter(/databases/$(database)/documents/users/$(uid));

      allow update, delete: if false;
    }

    // ---------- admins/{uid}: who is sysop -----------------------------------
    // A signed-in user may check only their own entry (so the page knows
    // whether to show sysop tools).
    match /admins/{uid} {
      allow get: if isSelf(uid);
      allow list, write: if false;
    }

    // =========================================================================
    // FORUM
    // =========================================================================

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function site() {
      return get(/databases/$(database)/documents/settings/site).data;
    }

    // Member with a handle and status "active" (muted and banned can't post),
    // and the forum is open (the sysop can always post).
    function canPost() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status == 'active'
        && (isAdmin() || !exists(/databases/$(database)/documents/settings/site) || site().forumOpen != false);
    }

    // Word filter: true if the text contains a banned word (whole words,
    // ignoring capitals). Banned words are limited to letters, numbers and
    // spaces when saved, so they're always safe to put in a pattern.
    function hasBannedWord(text) {
      return exists(/databases/$(database)/documents/settings/site)
        && site().get('bannedWords', []).size() > 0
        && text.lower().matches('(?s).*\\b(' + site().bannedWords.join('|') + ')\\b.*');
    }

    // This write must also bump the member's lastPostAt to now (rate limit).
    function bumpsLastPost() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastPostAt == request.time;
    }

    // Author fields on a new thread or post must be the real, current member.
    // authorRole drives the SYSOP badge, so it's checked against admins/.
    function authorFieldsOk(data) {
      return data.authorUid == request.auth.uid
        && data.authorHandle == me().handle
        && data.authorRole == (isAdmin() ? 'sysop' : 'member');
    }

    function validTitle(t) {
      return t is string && t.size() >= 3 && t.size() <= 120 && t.matches('(?s).*\\S.*');
    }

    function validBody(b) {
      return b is string && b.size() >= 1 && b.size() <= 10000 && b.matches('(?s).*\\S.*');
    }

    // ---------- settings/site: sysop notice, forum switch, word filter -------
    // Everyone reads. Changed only through the sysop's Cloud Function (logged).
    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- areas/{id}: [1] General ... [5] Off-Topic --------------------
    // Created by the deploy (scripts/seed.mjs). Read-only from the site.
    match /areas/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- threads/{threadId} -------------------------------------------
    // replyCount and lastReplyAt are kept up to date by Cloud Functions.
    // pinned / locked / hidden / areaId changes are sysop actions (Cloud Function).
    match /threads/{threadId} {
      // Hidden threads are invisible to everyone but the sysop. List queries
      // from the page must include where('hidden', '==', false).
      allow read: if resource.data.hidden == false || isAdmin();

      // A new thread whose title or opening post contains a banned word must be
      // created hidden and "held" for the sysop to review.
      allow create: if canPost()
        && request.resource.data.keys().hasOnly([
             'areaId', 'title', 'authorUid', 'authorHandle', 'authorRole',
             'createdAt', 'lastReplyAt', 'replyCount', 'pinned', 'locked', 'hidden', 'held'])
        && exists(/databases/$(database)/documents/areas/$(request.resource.data.areaId))
        && validTitle(request.resource.data.title)
        && authorFieldsOk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastReplyAt == request.time
        && request.resource.data.replyCount == 0
        && request.resource.data.pinned == false
        && request.resource.data.locked == false
        && (hasBannedWord(request.resource.data.title + ' '
              + getAfter(/databases/$(database)/documents/threads/$(threadId)/posts/op).data.body)
            ? request.resource.data.hidden == true && request.resource.data.held == true
            : request.resource.data.hidden == false && !('held' in request.resource.data))
        // the opening post (id "op") is written in the same batch
        && existsAfter(/databases/$(database)/documents/threads/$(threadId)/posts/op)
        && bumpsLastPost();

      allow update, delete: if false;

      // ---------- threads/{threadId}/posts/{postId} --------------------------
      // The opening post always has the id "op"; replies get random ids.
      match /posts/{postId} {
        function thread() {
          return get(/databases/$(database)/documents/threads/$(threadId)).data;
        }
        function threadAfter() {
          return getAfter(/databases/$(database)/documents/threads/$(threadId)).data;
        }

        allow read: if isAdmin() || (resource.data.hidden == false && thread().hidden == false);

        // A reply containing a banned word must be created hidden and "held".
        // (An opening post is never held itself; its thread is held instead.)
        allow create: if canPost()
          && request.resource.data.keys().hasOnly([
               'authorUid', 'authorHandle', 'authorRole', 'body', 'createdAt', 'hidden', 'held'])
          && authorFieldsOk(request.resource.data)
          && validBody(request.resource.data.body)
          && request.resource.data.createdAt == request.time
          && bumpsLastPost()
          && (postId == 'op'
                // "op" only together with a brand-new thread by the same author
                ? !exists(/databases/$(database)/documents/threads/$(threadId))
                  && threadAfter().authorUid == request.auth.uid
                  && request.resource.data.hidden == false && !('held' in request.resource.data)
                // replies only to an existing thread that isn't locked or hidden
                : thread().locked == false && thread().hidden == false
                  && (hasBannedWord(request.resource.data.body)
                      ? request.resource.data.hidden == true && request.resource.data.held == true
                      : request.resource.data.hidden == false && !('held' in request.resource.data)));

        // Authors can edit their own post's text within 30 minutes, if the
        // thread isn't locked, they can still post, and the new text passes
        // the word filter.
        allow update: if canPost()
          && resource.data.authorUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'editedAt'])
          && validBody(request.resource.data.body)
          && !hasBannedWord(request.resource.data.body)
          && request.resource.data.editedAt == request.time
          && request.time < resource.data.createdAt + duration.value(30, 'm')
          && thread().locked == false;

        // Authors can delete their own replies. The opening post can't be
        // deleted by members (deleting a whole thread is a sysop action).
        allow delete: if signedIn()
          && resource.data.authorUid == request.auth.uid
          && postId != 'op';
      }
    }

    // Collection-group queries over every thread's posts (member's posts,
    // posts today, held posts) are for the sysop dashboard only.
    match /{path=**}/posts/{postId} {
      allow read: if isAdmin();
    }

    // =========================================================================
    // MODERATION
    // =========================================================================

    // ---------- reports/{reportId}: a member reporting a post ----------------
    // ID is "{threadId}__{postId}__{reporterUid}", so each member can report a
    // given post only once. Muted members may report; banned members can't.
    // Only the sysop reads reports; their status changes via Cloud Function.
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow create: if signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().status in ['active', 'muted']
        && request.resource.data.keys().hasOnly([
             'threadId', 'postId', 'reporterUid', 'reporterHandle', 'reason', 'note', 'createdAt', 'status'])
        && reportId == request.resource.data.threadId + '__' + request.resource.data.postId + '__' + request.auth.uid
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterHandle == me().handle
        && request.resource.data.reason in ['spam', 'rude', 'off-topic', 'other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        // the post must exist and be visible
        && get(/databases/$(database)/documents/threads/$(request.resource.data.threadId)/posts/$(request.resource.data.postId)).data.hidden == false;

      allow update, delete: if false;
    }

    // ---------- modlog/{id}: every moderation action -------------------------
    // Written only by the moderation Cloud Function. Sysop reads.
    match /modlog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // =========================================================================
    // LIBRARY (wiki)
    // =========================================================================

    // ---------- library/{slug}: a wiki item (uploaded file or written page) --
    // The doc ID is the item's web address (/wiki/{slug}), so addresses are
    // unique. Everyone reads published items; drafts are sysop-only.
    // Only the sysop writes (from /wiki/add). Files live in Storage at
    // library/{slug}/{fileName}; see storage.rules.
    function validLibraryItem(slug) {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'slug', 'title', 'folder', 'kind', 'type', 'description', 'body',
               'storagePath', 'fileName', 'size', 'contentType',
               'status', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.slug == slug
        && slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && slug.size() <= 80
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 150
        && d.folder in ['guides', 'manuals', 'ebooks', 'files']
        && d.kind in ['file', 'page']
        && d.type in ['PDF', 'EPUB', 'GUIDE', 'MANUAL', 'DOC', 'SHEET', 'IMAGE', 'ZIP', 'TEXT', 'FILE']
        && d.description is string && d.description.size() <= 500
        && d.body is string && d.body.size() <= 100000
        // a file, if any, must be inside this item's own folder in Storage
        && (d.storagePath == '' || d.storagePath.matches('^library/' + slug + '/[^/]+$'))
        && d.size is int && d.size >= 0 && d.size <= 50 * 1024 * 1024
        && (d.kind == 'page' || d.storagePath != '')
        && d.status in ['draft', 'published']
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /library/{slug} {
      // Public list queries must include where('status', '==', 'published').
      allow read: if resource.data.status == 'published' || isAdmin();

      allow create: if isAdmin() && validLibraryItem(slug)
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin() && validLibraryItem(slug)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.kind == resource.data.kind;

      allow delete: if isAdmin();
    }

    // =========================================================================
    // REPCLOCK (apps/repclock): each member's own workouts and settings
    // =========================================================================

    // Private to the member: nobody else can read or write them, not even the
    // sysop. Values are the JSON text RepClock keeps on the device
    // (src/apps/repclock-sync.js).
    function optionalText(m, key, max) {
      return !(key in m) || (m[key] is string && m[key].size() <= max);
    }

    match /repclock/{uid} {
      allow read, delete: if isSelf(uid);

      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['settings', 'updatedAt'])
        && request.resource.data.settings is map
        && request.resource.data.settings.keys().hasOnly(['cfg', 'goals', 'theme', 'muted'])
        && optionalText(request.resource.data.settings, 'cfg', 20000)
        && optionalText(request.resource.data.settings, 'goals', 20000)
        && optionalText(request.resource.data.settings, 'theme', 100)
        && optionalText(request.resource.data.settings, 'muted', 20)
        && request.resource.data.updatedAt == request.time;

      // One doc per saved workout; the ID is RepClock's workout id (a number).
      match /workouts/{workoutId} {
        allow read, delete: if isSelf(uid);

        allow create, update: if isSelf(uid)
          && workoutId.matches('^[0-9]{1,20}$')
          && request.resource.data.keys().hasOnly(['json', 'date', 'updatedAt'])
          && request.resource.data.json is string && request.resource.data.json.size() <= 50000
          && request.resource.data.date is string && request.resource.data.date.size() <= 40
          && request.resource.data.updatedAt == request.time;
      }
    }

    // =========================================================================
    // HOME PROJECTS (apps/home-projects): each member's own projects
    // =========================================================================

    // Private to the member: nobody else can read or write them, not even the
    // sysop. One doc per project, in the app's own format
    // (src/apps/homeprojects-backend.js).
    match /homeprojects/{uid}/projects/{projectId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid) && projectId.matches('^[A-Za-z0-9_-]{1,64}$');
    }

    // =========================================================================
    // LOGBOOK (apps/logbook) + PROJECT TRACKER (apps/project-tracker)
    // =========================================================================

    // Private to the member: nobody else can read or write them, not even the
    // sysop. Docs are in the apps' own format (src/apps/logbook-backend.js):
    //   logbook/{uid}/records/{id}          engines, vehicles, parts (inventory)
    //   logbook/{uid}/projects/{id}         Project Tracker projects and jobs
    //   logbook/{uid}/trackerSettings/{id}  Project Tracker counter and shop info
    match /logbook/{uid}/{part}/{docId} {
      allow read, delete: if isSelf(uid) && part in ['records', 'projects', 'trackerSettings'];
      allow create, update: if isSelf(uid)
        && part in ['records', 'projects', 'trackerSettings']
        && docId.matches('^[A-Za-z0-9_-]{1,64}$')
        && request.resource.data is map;
    }
  }
}
