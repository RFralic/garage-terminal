{
  "name": "garage-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Garage Terminal: home page, forum, wiki/library and moderation tools on Firebase.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "firebase emulators:exec --only firestore,storage --project demo-garage-terminal \"node --test --test-concurrency=1 tests/*.test.js\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage --project demo-garage-terminal",
    "seed:local": "FIRESTORE_EMULATOR_HOST=localhost:8080 node scripts/seed.mjs",
    "check:phone": "firebase emulators:exec --only auth,firestore,storage --project demo-garage-terminal \"node scripts/check-phone.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.35.0",
    "playwright": "^1.63.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "firebase": "^12.19.0",
    "marked": "^18.2.0"
  }
}
